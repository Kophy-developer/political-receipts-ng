# Server only. Leave these empty in git. Never prefix them with NEXT_PUBLIC_.
X_CLIENT_ID=
X_CLIENT_SECRET=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Server only. Claim extraction. Never prefix with NEXT_PUBLIC_.
# Optional. When unset, the server uses the default in lib/ai/env.ts (currently gemini-3.8-flash).
GEMINI_MODEL=
GEMINI_API_KEY=

# Server only. Research search. Never prefix with NEXT_PUBLIC_.
# Tavily is the primary provider. Brave is the secondary provider.
# RESEARCH_PROVIDER=tavily or brave. Default tavily.
# RESEARCH_BILLING_DAY is the UTC day the monthly allowance resets (1-28). Default 1.
# Set it to the provider's real reset day when you know it.
TAVILY_API_KEY=
BRAVE_API_KEY=
RESEARCH_PROVIDER=
RESEARCH_BILLING_DAY=
TAVILY_MONTHLY_CEILING=
BRAVE_MONTHLY_CEILING=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 32-byte key, base64. Generate with: openssl rand -base64 32
# Add it in the Vercel project environment. Never commit the value.
# Never prefix it with NEXT_PUBLIC_.
TOKEN_ENCRYPTION_KEY=
