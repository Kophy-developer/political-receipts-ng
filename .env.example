# Server only. Leave these empty in git. Never prefix them with NEXT_PUBLIC_.
X_CLIENT_ID=
X_CLIENT_SECRET=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Server only. Drafting tries Groq, then OpenRouter, then Gemini.
# AI_PAID_USAGE_ENABLED must be the string true before a paid route is used. Default false.
# GROQ_MODEL defaults to openai/gpt-oss-20b. OPENROUTER_MODEL defaults to openrouter/free.
# A model that is not on the free list is skipped while paid usage is off.
# Daily ceilings are desk limits. Gemini stays at 8 and is counted on its own.
AI_PAID_USAGE_ENABLED=false
GROQ_API_KEY=
GROQ_MODEL=
GROQ_DAILY_REQUESTS=
# Output budgets. Health stays small. Extraction and four-style drafts are separate.
# Values outside 64–8192 are ignored and the default is used.
# Defaults: health 1024, extraction 2048, draft 4096.
AI_HEALTH_MAX_TOKENS=
AI_EXTRACTION_MAX_TOKENS=
AI_DRAFT_MAX_TOKENS=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_DAILY_REQUESTS=

# Server only. Claim extraction, and the third draft provider. Never prefix with NEXT_PUBLIC_.
# Optional. When unset, the server uses the default in lib/ai/catalog.ts (currently gemini-3.8-flash).
GEMINI_MODEL=
GEMINI_API_KEY=

# Server only. Research search. Never prefix with NEXT_PUBLIC_.
# Tavily is the primary provider. Brave is the secondary provider.
# RESEARCH_PROVIDER=tavily or brave. Default tavily.
# RESEARCH_BILLING_DAY is the UTC day the monthly allowance resets (1-28). Default 1.
# Set it to the provider's real reset day when you know it.
TAVILY_API_KEY=
BRAVE_API_KEY=
RESEARCH_PROVIDER=
RESEARCH_BILLING_DAY=
TAVILY_MONTHLY_CEILING=
BRAVE_MONTHLY_CEILING=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server only. Vercel Cron and manual schedule runners send this as Bearer.
# Scheduling stays off in desk_schedule until an editor arms it in Settings.
# Never prefix with NEXT_PUBLIC_.
CRON_SECRET=

# 32-byte key, base64. Generate with: openssl rand -base64 32
# Add it in the Vercel project environment. Never commit the value.
# Never prefix it with NEXT_PUBLIC_.
TOKEN_ENCRYPTION_KEY=
